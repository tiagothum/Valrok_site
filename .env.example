# Exemplo de configuração — SEM segredos. O site não precisa de credenciais
# do banco, JWT_SECRET_KEY nem GAME_SERVER_TOKEN.

# development | staging | production  (na Vercel, sem esta variável, o padrão é staging)
VALROK_ENV=development

# URL pública do site (usada no sitemap e nas meta tags)
SITE_URL=http://127.0.0.1:8080

# Respostas simuladas da valrokapi (somente dev). Proibido em produção.
MOCK_API=true

# Proxy local /api/* -> VALROKAPI_URL, simulando o Nginx (somente dev).
DEV_API_PROXY=false
VALROKAPI_URL=http://127.0.0.1:8000

# CSP em modo observação até validar todas as telas; depois false (bloqueante).
CSP_REPORT_ONLY=true

# Convite público do Discord
DISCORD_URL=#

# Versão dos assets (cache busting). Na Vercel usa o ID do deploy automaticamente;
# em servidor próprio, defina a cada deploy.
ASSET_VERSION=

# Redes sociais
YOUTUBE_URL=https://www.youtube.com/@ValrokMMORPG
# ID do canal para listar os últimos vídeos na home (feed público, sem chave de API). Vazio desativa.
YOUTUBE_CHANNEL_ID=UCqMkw73corJp2z1P1QEmPzA
INSTAGRAM_URL=https://www.instagram.com/valrok.mmorpg/
